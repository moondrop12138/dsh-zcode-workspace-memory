{
  "name": "dsh-workspace-memory",
  "version": "0.1.0",
  "description": "Workspace memory for DSH: a per-workspace Markdown memory directory (MEMORY.md index + one fact per file) injected into every main session and refreshed by background extraction, ported from ZCode",
  "type": "module",
  "main": "lib/host.js",
  "exports": {
    ".": "./lib/host.js",
    "./client": "./lib/client.js",
    "./memory-core": "./lib/memory-core.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "locale/",
    "icon.svg",
    "README.md",
    "INTERFACES.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "memory",
    "workspace-memory",
    "long-term-memory"
  ],
  "license": "MIT",
  "scripts": {
    "test": "node --test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
